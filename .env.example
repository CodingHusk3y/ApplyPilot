# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_PROVIDER=ollama     # Use Ollama for scoring/tailoring
# LLM_URL=http://127.0.0.1:11434/v1  # Ollama OpenAI-compatible endpoint for text tasks
# LLM_MODEL=qwen3:14b     # Model for scoring/tailoring

# Local browser auto-apply (experimental; requires Ollama + a tool-capable model)
# APPLY_PROVIDER=ollama
# APPLY_MODEL=qwen3:14b
# OLLAMA_THINK=false      # Disable long reasoning before browser tool calls
# OLLAMA_MAX_TOKENS=2048
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_ALL_TOOLS=false  # Keep the browser tool schema small for local models

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
